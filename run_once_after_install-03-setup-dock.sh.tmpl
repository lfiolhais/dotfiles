{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Appends to the Dock rather than replacing it: there is no `dockutil --remove
# all` here, so Apple's defaults stay and these six land after them. Editing this
# script re-runs it, because the run_once_ hash changes; a re-run leaves the Dock
# as it is, because dockutil refuses an app the Dock already has.

# dockutil comes from the Brewfile, and this runs before any shell has loaded
# Homebrew's environment. Apple Silicon prefix; an Intel Mac uses /usr/local.
eval "$(/opt/homebrew/bin/brew shellenv)"

dockutil --add /System/Applications/Mail.app
dockutil --add /System/Volumes/Preboot/Cryptexes/App/System/Applications/Safari.app/ --after 'Mail'
dockutil --add /Applications/Tapestry.app --after 'Safari'
dockutil --add /Applications/Ghostty.app --after 'Tapestry'
dockutil --add /System/Applications/Notes.app --after 'Ghostty'
dockutil --add /System/Applications/Music.app --after 'Notes'

# On a re-run every one of those fails: dockutil prints "<app> already exists in
# dock. Use --replacing '<app>' to update an existing item", adds nothing, and
# exits 1. This echo is the last command, so the script still reports success --
# at the cost of hiding a genuine dockutil failure too.
echo "Completed Dock setup"

{{ end -}}
