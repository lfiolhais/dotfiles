#!/usr/bin/env bash
set -eu

{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"

if ! grep -qxF "$(command -v fish)" /etc/shells; then
    command -v fish | sudo tee -a /etc/shells
fi

chsh -s "$(which fish)"
{{- else if eq .chezmoi.os "linux" -}}
{{ if .sudo -}}
# Use sudo only when not already root (test containers run as root).
SUDO=()
if [ "$(id -u)" -ne 0 ]; then
    SUDO=(sudo)
fi

if ! grep -qxF "$(command -v fish)" /etc/shells; then
    command -v fish | sudo tee -a /etc/shells
fi

chsh -s "$(which fish)"
{{- else -}}
fish_path="$HOME/.local/share/mise/shims/fish"
grep -qF "exec $fish_path" "$HOME/.bashrc" || echo "exec $fish_path" >> "$HOME/.bashrc"
{{- end }}
{{- end }}
