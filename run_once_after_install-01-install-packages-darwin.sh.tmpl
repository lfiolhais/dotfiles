{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Homebrew is what installs everything else on macOS, so this script fails loudly
# rather than leaving a half-provisioned machine behind: chezmoi records a
# run_once_ script only when it exits 0, and the next apply runs an unrecorded
# one again. `chezmoi state delete-bucket --bucket=scriptState` is what re-runs
# it after a success.
set -u

# Without TERM (ssh without a tty, a container) tput exits 2 and prints an
# error; the styling is cosmetic, so it falls back to plain text.
bold=$(tput bold 2>/dev/null || true)
normal=$(tput sgr0 2>/dev/null || true)

echo "${bold}===Setup Homebrew===${normal}"

brewfile="${HOME}/.config/Brewfile"

if ! command -v brew > /dev/null 2>&1; then
    # The download is checked apart from the run: `bash -c "$(curl ...)"` runs
    # `bash -c ""` when curl fails, which succeeds having installed nothing,
    # and the failure would only surface two steps later as a missing brew.
    if ! installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
        echo "Downloading the Homebrew installer failed. Check the network and" >&2
        echo "re-run 'chezmoi apply'." >&2
        exit 1
    fi
    /bin/bash -c "${installer}"

    # The installer does not put brew on this shell's PATH. Apple Silicon
    # prefix; an Intel Mac installs to /usr/local instead.
    if [ ! -x /opt/homebrew/bin/brew ]; then
        echo "The installer finished without leaving brew at /opt/homebrew/bin." >&2
        echo "Fix what it printed above and re-run 'chezmoi apply'." >&2
        exit 1
    fi
    eval "$(/opt/homebrew/bin/brew shellenv)"
else
    # `brew bundle install` below resolves names against the API index and the
    # tap remotes, so refresh them first. exports.fish sets
    # HOMEBREW_NO_AUTO_UPDATE, so brew will not refresh them by itself in any
    # fish shell this repository configures; doing it here means an apply from
    # fish and an apply from bash behave the same. Only this branch needs it:
    # a brew installed above arrives current.
    #
    # A failed update does not stop anything. The old index still resolves, and
    # the bundle below is the step that has to succeed.
    echo "Updating the Homebrew already on this machine before installing."
    brew update || echo "brew update failed; continuing on the index as it is." >&2
fi

# Two passes over one file, because the two halves fail for different reasons and
# only one of them is fatal. `brew bundle install` takes no per-type filter, so
# the type is chosen by feeding it a filtered Brewfile on stdin.
#
# Taps, formulae, casks and uv tools first: everything below this script depends
# on them, and a missing fish makes 04 fail too.
grep -v '^mas ' "${brewfile}" | brew bundle install --file=-
bundle_status=${PIPESTATUS[1]}

if [ "${bundle_status}" -ne 0 ]; then
    echo >&2
    echo "brew bundle failed (exit ${bundle_status}). Still missing:" >&2
    grep -v '^mas ' "${brewfile}" \
        | brew bundle check --file=- --no-upgrade --verbose >&2
    echo >&2
    echo "Fix the cause and re-run:" >&2
    echo "    grep -v '^mas ' ${brewfile} | brew bundle install --file=-" >&2
    echo >&2
    echo "This script was not recorded, so the next 'chezmoi apply' runs it" >&2
    echo "again, and stops here again until the bundle installs cleanly." >&2
    exit 1
fi

# The App Store second. Each `mas` entry needs the App Store signed in with the
# terms accepted, and `mas` cannot say whether it is: it has `signout` and
# nothing that reports the current state. On a machine that has never signed in
# it does not fail and return either -- it waits for a sign-in. That is what the
# Lume guest runs into, having no App Store account, and why
# tests/lume/entrypoint.sh skips these entries. An apply with nobody at the
# keyboard would wait forever, and chezmoi would record nothing, so the pass is
# given a ceiling.
#
# The ceiling is for that wait, not for a slow link: these apps are several
# gigabytes and a fresh machine downloads all of them here. gtimeout comes from
# coreutils, which the pass above installed; a machine without it runs the pass
# unbounded rather than not at all.
#
# Nothing else in the bootstrap depends on these apps, so neither a failure nor
# the ceiling stops the apply.
mas_limit=3600

run_mas_pass() {
    if command -v gtimeout > /dev/null 2>&1; then
        # --foreground leaves the pass in this script's process group, which is
        # the terminal's foreground group, so a prompt it raises can be answered.
        # Without it gtimeout calls setpgid(2) first, the pass runs in a
        # background group, and the kernel stops it with SIGTTIN the moment it
        # reads the terminal: the prompt is on screen and nothing typed reaches
        # it. The cost is that the ceiling then covers only `brew bundle`
        # itself, not a `mas` it leaves behind.
        #
        # 124 when the ceiling is reached, 137 when the pass ignored the TERM
        # that came first and had to be killed.
        gtimeout --foreground --kill-after=30s "${mas_limit}" \
            brew bundle install --file=-
    else
        brew bundle install --file=-
    fi
}

mas_status=0
grep '^mas ' "${brewfile}" | run_mas_pass || mas_status=$?

if [ "${mas_status}" -eq 124 ] || [ "${mas_status}" -eq 137 ]; then
    echo
    echo "The App Store pass was still running after ${mas_limit}s and was stopped."
    echo "An App Store this machine has never signed in to looks like this:"
    echo "mas waits for a sign-in instead of failing."
    echo
    echo "Open App Store.app, sign in, accept anything it asks for, then run:"
    echo "    grep '^mas ' ${brewfile} | brew bundle install --file=-"
    echo
    echo "If this machine is signed in, the apps were still downloading, and"
    echo "the same command finishes them."
elif [ "${mas_status}" -ne 0 ]; then
    echo
    echo "The App Store apps in the Brewfile were not installed (exit ${mas_status})."
    echo "The usual cause is an App Store that has never been signed in on this"
    echo "machine, or terms that have not been accepted since the last update."
    echo
    echo "Open App Store.app, sign in, accept anything it asks for, then run:"
    echo "    grep '^mas ' ${brewfile} | brew bundle install --file=-"
    echo
    echo "'mas list' prints the App Store apps this machine already has."
fi

echo "${bold}===Setup Rust===${normal}"

# Homebrew does not put rustup's copies of cargo, rustc and rustfmt in
# /opt/homebrew/bin with everything else. They stay in rustup's own directory,
# which `brew --prefix rustup`/bin names, and exports.fish adds that to PATH.
#
# Installing rustup installs no compiler. `rustup default stable` downloads one
# and makes it the default.
#
# `brew --prefix` prints a path for any formula Homebrew knows, installed or
# not, and the directory exists only once it is installed. The test below looks
# for the rustup binary.
#
# Nothing else in the bootstrap needs Rust. If this fails the apply keeps going.
rustup_prefix="$(brew --prefix rustup 2> /dev/null || true)"

if [ -n "${rustup_prefix}" ] && [ -x "${rustup_prefix}/bin/rustup" ]; then
    if ! "${rustup_prefix}/bin/rustup" default stable; then
        echo
        echo "No Rust toolchain was installed. Once the cause is fixed:"
        echo "    ${rustup_prefix}/bin/rustup default stable"
    fi
else
    echo
    echo "rustup is not installed. It is in the Brewfile, so the bundle above"
    echo "missed it. Re-run:"
    echo "    grep -v '^mas ' ${brewfile} | brew bundle install --file=-"
fi
{{ end -}}
