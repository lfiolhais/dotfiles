#!/usr/bin/env python3
r"""Keep the NAS share mounted while it is reachable, and quiet while it is not.

Run without arguments this is what the LaunchAgent runs on every network change:
it mounts the share when the NAS answers, clears the mount when it stops
answering, and does nothing at all in the two cases where nothing can be done --
away from the network, or with no password in the Keychain. Those two are
silent by design, because the alternative to silence is a dialog.

One thing has to be done by hand, once per machine, and until it is done the
agent mounts nothing -- the password goes in the login Keychain::

    security add-internet-password -r "smb " -s nas.botasal.xyz -a lfiolhais \
      -D "Network Password" \
      -T /System/Library/CoreServices/NetAuthAgent.app/Contents/MacOS/NetAuthAgent \
      -U -w

``-w`` last so it prompts rather than reaching ``ps``; ``-T`` names NetAuthAgent
because that is what reads the item when ``mount volume`` authenticates.
Connecting once in Finder writes an equivalent item, provided the URL is typed
rather than picked out of the sidebar: the item records the name used to
connect, and this looks it up by ``nas.botasal.xyz``.

``status`` says whether that has happened, which is the first thing to check
when the share is not appearing.

Usage::

    mount-nas              # mount when reachable, unmount when not
    mount-nas status       # reachability, Keychain, and where the share is
    mount-nas mount        # mount now, saying why if it cannot
    mount-nas flush        # write outstanding data back to every mounted volume
    mount-nas unmount      # flush, then unmount; refuses while a file is open
    mount-nas unmount -f   # tear the mount down anyway, discarding what is open
    mount-nas … --dry-run  # print the commands, run none of them
"""

from __future__ import annotations

import argparse
import shlex
import sys
from pathlib import Path

# The shared library sits beside this script's bin directory, not on sys.path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "python"))

from mountnas import (
    AWAY,
    MOUNTED,
    NO_PASSWORD,
    PATIENT_TIMEOUT,
    PRESENT,
    SHARES,
    TIMEOUT,
    UNMOUNTED,
    NasError,
    Outcome,
    PackagesError,
    flush,
    mount,
    sync,
    table,
    unmount,
)

# What each outcome of a pass is called when a person asks.
REPORT = {
    AWAY: "not reachable, nothing mounted",
    PRESENT: "already mounted",
    MOUNTED: "mounted",
    UNMOUNTED: "unmounted, the NAS stopped answering",
    NO_PASSWORD: "reachable, but no password in the Keychain",
}


def show(outcome: Outcome, *, dry_run: bool) -> None:
    """Print one outcome for a person to read.

    Args:
        outcome: The outcome to describe.
        dry_run: Whether the command was printed rather than run.

    """
    prefix = "would run" if dry_run else "ran"
    detail = f"  [{prefix}: {shlex.join(outcome.argv)}]" if outcome.argv else ""
    result = REPORT[outcome.action] if outcome.ok else f"failed: {outcome.error}"
    print(f"{outcome.share.name}: {result}{detail}")


def cmd_sync(*, dry_run: bool) -> int:
    """Mount or unmount as the network allows, reporting only real failures.

    This is what launchd runs. Everything it decides is expected, so nothing is
    printed while nothing is wrong; the agent's log stays empty and a line in it
    means something needs looking at.

    Args:
        dry_run: Report the commands without running them.

    Returns:
        Process exit code: 1 if any share failed, otherwise 0.

    """
    outcomes = sync(dry_run=dry_run)
    if dry_run:
        for outcome in outcomes:
            show(outcome, dry_run=True)
        return 0

    failed = [outcome for outcome in outcomes if not outcome.ok]
    for outcome in failed:
        print(f"mount-nas: {outcome.share.name}: {outcome.error}", file=sys.stderr)
    return 1 if failed else 0


def cmd_status() -> int:
    """Report what each share is doing and why.

    A pass has one question -- can the share be mounted -- so every way the NAS
    can fail to answer means the same thing to it. This is the command a person
    runs with the share missing, and there the ways differ: a name that stopped
    resolving is a DNS fix, a port that refuses is the NAS itself, and a link
    too slow for the two seconds a pass allows is neither. So the reason the
    socket gave is printed under the verdict, along with the addresses the name
    resolves to, since a name pointing at some other machine fails exactly like
    a NAS that is switched off.

    Returns:
        Process exit code: always 0. Every state this reports is a fact about
        the network or the Keychain rather than a failure of the command.

    """
    snapshot = table()
    for share in SHARES:
        path = share.mountpoint(snapshot)
        where = f"mounted at {path}" if path else "not mounted"
        reach = share.probe()
        if not reach.ok:
            print(f"{share.name}: {share.host} not reachable, {where}")
            print(f"  {reach.detail}")
            addresses = share.addresses()
            if addresses:
                print(f"  {share.host} resolves to {', '.join(addresses)}")
            if reach.timed_out and share.probe(PATIENT_TIMEOUT).ok:
                print(
                    f"  it does answer within {PATIENT_TIMEOUT}s. A pass waits "
                    f"{TIMEOUT}s so that a login is never held up, so this link "
                    f"is too slow for the agent to mount over.",
                )
        elif share.has_password():
            print(f"{share.name}: {share.host} reachable, password in Keychain, {where}")
        else:
            print(f"{share.name}: {share.host} reachable, {where}")
            print(f"  no password in the Keychain for {share.user}@{share.host}, so nothing")
            print(f"  will be mounted. Connect once in Finder to {share.url} and tick")
            print('  "Remember this password in my keychain".')
    return 0


def cmd_mount(*, dry_run: bool) -> int:
    """Mount every share that is not already mounted.

    Args:
        dry_run: Report the commands without running them.

    Returns:
        Process exit code: 1 if any share could not be mounted, otherwise 0.

    """
    snapshot = table()
    failed = False
    for share in SHARES:
        path = share.mountpoint(snapshot)
        if path:
            print(f"{share.name}: already mounted at {path}")
            continue
        if not share.reachable():
            print(f"{share.name}: {share.host} is not reachable", file=sys.stderr)
            failed = True
            continue
        if not share.has_password():
            print(f"{share.name}: no password in the Keychain for {share.url}", file=sys.stderr)
            failed = True
            continue
        outcome = mount(share, dry_run=dry_run)
        show(outcome, dry_run=dry_run)
        failed = failed or not outcome.ok
    return 1 if failed else 0


def cmd_flush(*, dry_run: bool) -> int:
    """Write outstanding data back to every mounted volume.

    Worth running by hand before the network goes away -- shutting a laptop and
    carrying it elsewhere is what turns an outstanding write into a lost one,
    because the NAS is gone by the time anything notices.

    Args:
        dry_run: Report the command without running it.

    Returns:
        Process exit code: 0. A flush that fails raises ``NasError``.

    """
    argv = flush(dry_run=dry_run)
    print(f"{'would run' if dry_run else 'ran'}: {shlex.join(argv)}")
    return 0


def cmd_unmount(*, force: bool, dry_run: bool) -> int:
    """Unmount every share that is mounted.

    A share whose server still answers is flushed and then unmounted plainly, so
    an open file or an outstanding write refuses the unmount instead of being
    discarded; ``force`` is what overrides that refusal. A share whose server has
    stopped answering is forced whatever was asked, because nothing can be
    written back to it and the stale mount raises interrupted-connection alerts
    until it is cleared.

    Args:
        force: Tear a reachable mount down without waiting for its writes.
        dry_run: Report the commands without running them.

    Returns:
        Process exit code: 1 if any share could not be unmounted, otherwise 0.

    """
    snapshot = table()
    mounted = []
    for share in SHARES:
        path = share.mountpoint(snapshot)
        if path is None:
            print(f"{share.name}: not mounted")
        else:
            mounted.append((share, path, share.reachable()))

    # One flush covers every volume, so it is done once rather than per share,
    # and only while something it could still write to is answering.
    if not force and any(reachable for _, _, reachable in mounted):
        flush(dry_run=dry_run)

    failed = False
    for share, path, reachable in mounted:
        gone = not reachable
        outcome = unmount(share, path, force=force or gone, dry_run=dry_run)
        show(outcome, dry_run=dry_run)
        if not outcome.ok and not (force or gone):
            print(
                f"{share.name}: something still has it open. Close that, or "
                f"'mount-nas unmount --force' to tear it down and lose whatever "
                f"has not been written back.",
                file=sys.stderr,
            )
        failed = failed or not outcome.ok
    return 1 if failed else 0


def main() -> int:
    """Parse arguments and run the requested command.

    Returns:
        Process exit code: 0 on success, 1 on a reported failure.

    """
    parser = argparse.ArgumentParser(
        prog="mount-nas",
        description="Mount the NAS while it is reachable, silently when it is not.",
        epilog="with no command: mount when reachable, unmount when not",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="sync",
        choices=("sync", "status", "mount", "flush", "unmount"),
        help="what to do (default: sync)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the commands instead of running them",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help=(
            "unmount: tear the mount down even while the NAS answers and files "
            "are open, discarding anything not yet written back. Without it a "
            "busy mount refuses, and a NAS that has stopped answering is forced "
            "anyway"
        ),
    )
    args = parser.parse_args()

    try:
        if args.command == "status":
            return cmd_status()
        if args.command == "mount":
            return cmd_mount(dry_run=args.dry_run)
        if args.command == "flush":
            return cmd_flush(dry_run=args.dry_run)
        if args.command == "unmount":
            return cmd_unmount(force=args.force, dry_run=args.dry_run)
        return cmd_sync(dry_run=args.dry_run)
    except (NasError, PackagesError) as exc:
        print(f"mount-nas: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
