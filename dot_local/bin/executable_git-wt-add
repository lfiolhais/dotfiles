#!/usr/bin/env python3
"""Check a branch, tag, or commit out into its own folder.

Run from anywhere inside a repository cloned by ``git-wt-clone`` (the root, or
any existing worktree). The new folder is always created beside ``.bare``, named
after the ref with slashes flattened, so ``feature/foo`` lands in
``feature-foo``.

How the argument is treated:

- a branch is checked out as a branch, tracking ``origin`` when it exists only
  there;
- a tag or commit is checked out detached, since moving a branch onto a tag is
  never what was meant;
- anything unknown triggers one fetch, and if it is still unknown it becomes a
  new branch off the default branch -- after a confirmation when run at a
  terminal, because a typo'd branch name lands here too. The new branch
  deliberately has **no** upstream: git would otherwise track the branch it
  forked from, whose name differs, and ``git push`` refuses that. The first
  push sets the upstream to ``origin/<ref>`` instead, provided
  ``push.autoSetupRemote`` is on.

The worktree path is printed on stdout, so ``cd (git wt-add <ref>)`` lands
straight into it.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

# The shared library sits beside this script's bin directory, not on sys.path.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib" / "python"))

from gitwt import GitWtError, Repo, Worktree


def main() -> int:
    """Parse arguments and add the worktree.

    Returns:
        Process exit code: 0 on success, 1 on a reported failure.

    """
    parser = argparse.ArgumentParser(
        prog="git-wt-add",
        description="Check a branch, tag, or commit out into its own folder.",
        epilog="example: git-wt-add feature/login",
    )
    parser.add_argument("ref", help="branch, tag, commit, or new branch name")
    args = parser.parse_args()

    def confirm_new(default: str) -> bool:
        """Ask before a ref that matches nothing becomes a new branch.

        Args:
            default: The default branch the new branch would fork from.

        Returns:
            True to create it. Without a terminal there is nobody to ask, so a
            scripted caller keeps the old unconditional behaviour.

        """
        if not sys.stdin.isatty():
            return True
        answer = input(
            f"git-wt-add: {args.ref!r} matches no branch, tag or commit; "
            f"create it as a new branch off {default}? [y/N] ",
        )
        return answer.strip().lower() in {"y", "yes"}

    try:
        repo = Repo.discover(Path.cwd())
        worktree = Worktree.add_worktree(repo, args.ref, confirm_new=confirm_new)
    except GitWtError as exc:
        print(f"git-wt-add: {exc}", file=sys.stderr)
        return 1

    print(f"{worktree.path.name}/  {worktree.summary}", file=sys.stderr)
    print(worktree.path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
