{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# launchd caches a job's definition when it is bootstrapped, so an edited plist
# is only read on a fresh one. The digest below changes this script whenever the
# plist changes, which is what makes chezmoi re-run it and reload the agent.
# plist: {{ include "Library/LaunchAgents/xyz.botasal.mount-nas.plist.tmpl" | sha256sum }}
set -eu

bold=$(tput bold)
normal=$(tput sgr0)

echo "${bold}===Setup NAS===${normal}"

label="xyz.botasal.mount-nas"
plist="${HOME}/Library/LaunchAgents/${label}.plist"
domain="gui/$(id -u)"

# botasal.xyz is served on the home network and delegated publicly to a zone
# that carries none of its names. A query made anywhere else is answered
# NXDOMAIN, and macOS caches that for as long as the public zone's SOA says --
# `dig botasal.xyz SOA` prints the value -- so the laptop comes home holding an
# answer that says the NAS does not exist. Naming the resolvers here takes the
# zone off the public path: at home they answer, and away from home the query
# times out, which leaves nothing behind to serve on arrival.
#
# The whole zone rather than the one name: every name in it is on the home
# network, so each one wants the same treatment -- failing away from home,
# without leaving a cached denial that outlasts the trip.
resolver="/etc/resolver/botasal.xyz"
resolvers="nameserver 192.168.1.78
nameserver 192.168.1.73"

write_resolver() {
    sudo mkdir -p /etc/resolver
    printf '%s\n' "${resolvers}" | sudo tee "${resolver}" > /dev/null
    # Installing the file is also the moment the poisoned answer is dropped:
    # without this, whatever is already cached is served until it expires.
    sudo dscacheutil -flushcache
    sudo killall -HUP mDNSResponder
    echo "Wrote ${resolver}: delta7 and stardestroyer answer for botasal.xyz."
}

if [ "$(cat "${resolver}" 2>/dev/null || true)" = "${resolvers}" ]; then
    echo "${resolver} already names both resolvers."
elif sudo -n true 2>/dev/null; then
    write_resolver
elif [ -t 0 ]; then
    echo "Writing ${resolver} needs root. sudo asks for the account password."
    write_resolver
else
    echo "${resolver} needs writing and this apply has no terminal to ask for" >&2
    echo "a password on. Until it names both resolvers, a cached NXDOMAIN from" >&2
    echo "away can stop the NAS mounting at home. Run:" >&2
    echo "    sudo mkdir -p /etc/resolver" >&2
    echo "    printf 'nameserver 192.168.1.78\nnameserver 192.168.1.73\n' \\" >&2
    echo "      | sudo tee ${resolver}" >&2
    echo "    sudo dscacheutil -flushcache && sudo killall -HUP mDNSResponder" >&2
fi

# launchd writes the log itself but creates no directory for it.
mkdir -p "${HOME}/.local/state"

# bootstrap refuses a label that is already loaded, and an agent loaded from the
# previous plist would otherwise keep running the old definition.
launchctl bootout "${domain}/${label}" 2>/dev/null || true
launchctl bootstrap "${domain}" "${plist}"

echo "Loaded ${label}: the NAS share mounts whenever nas.botasal.xyz answers."
echo
echo "One step is left, and until it is done the agent mounts nothing."
echo "The agent needs the password from the login Keychain, and asking for one"
echo "it does not have is the dialog this exists to avoid."
echo
echo "Store it (-w last, so it prompts instead of reaching ps and history):"
echo '    security add-internet-password -r "smb " -s nas.botasal.xyz \'
echo '      -a lfiolhais -D "Network Password" \'
echo '      -T /System/Library/CoreServices/NetAuthAgent.app/Contents/MacOS/NetAuthAgent \'
echo '      -U -w'
echo
echo "Then: mount-nas status, which reports whether the lookup finds it."
echo
echo "If the first mount raises a Keychain prompt, answer Always Allow: the"
echo "reader is NetAuthAgent, and that grants it the access -T was meant to."
echo
echo "Finder -> Go -> Connect to Server -> smb://nas.botasal.xyz/Book2 also"
echo "works. Type that URL rather than picking the NAS out of the sidebar: the"
echo "item is stored under whatever name was used to connect, and mount-nas"
echo "looks it up by nas.botasal.xyz."
echo
echo "The agent appears under System Settings -> General -> Login Items &"
echo "Extensions as a background item. Leave it enabled; disabled, it looks"
echo "exactly like a broken script."
{{ end -}}
