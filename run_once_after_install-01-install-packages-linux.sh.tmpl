{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Two profiles:
#   * sudo:    native package manager (apt/dnf), plus gh and starship from their
#              own repo/installer -- the only two exceptions, because neither is
#              in any base repository. A tool the distro does not package is
#              simply not installed.
#   * no-sudo: rootless mise under ~/.local -- the only option without root.
#
# The package names come from .chezmoidata/packages.toml, which maps every
# Brewfile formula onto its per-distro equivalent. Edit the manifest with
# `chezmoi-packages`, not this list; tests/check.py fails if the two drift apart.
set -eu
{{ if .sudo }}
# Use sudo only when not already root (test containers run as root).
SUDO=()
if [ "$(id -u)" -ne 0 ]; then
    SUDO=(sudo)
fi
{{ $target := includeTemplate "linux-target" . -}}
{{ if ne $target "apt" }}
# --- Fedora / RHEL family (RHEL, Rocky, AlmaLinux, CentOS Stream) ------------
{{- if eq $target "el" }}
# RHEL rebuilds keep the CLI tools in EPEL, some of whose deps need the CRB repo.
"${SUDO[@]}" dnf install -y dnf-plugins-core epel-release
"${SUDO[@]}" dnf config-manager --set-enabled crb 2> /dev/null \
    || "${SUDO[@]}" dnf config-manager --set-enabled powertools 2> /dev/null \
    || true
{{- end }}
packages=(
    # Bootstrap-only: no Brewfile counterpart. RHEL 9's minimal install lacks
    # `which` and `chsh` (util-linux-user), both of which the fish setup script
    # needs; the compiler stands in for the Xcode CLI tools the darwin bootstrap
    # installs, which is what makes cmake, boost and CUnit below any use.
    curl file fontconfig which util-linux-user python3 ca-certificates
    gcc gcc-c++ make
{{ includeTemplate "linux-packages" . | trim | indent 4 }}
)
# --allowerasing lets curl replace RHEL's curl-minimal instead of conflicting.
"${SUDO[@]}" dnf install -y --allowerasing "${packages[@]}"
{{ if eq $target "fedora" -}}
# gh ships in Fedora's own repositories.
"${SUDO[@]}" dnf install -y gh
{{- else }}
# gh is not in EPEL; add its official repository.
"${SUDO[@]}" dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo
"${SUDO[@]}" dnf install -y gh
{{- end }}
{{- else }}
# --- Debian / Ubuntu / Pop!_OS ----------------------------------------------
"${SUDO[@]}" apt-get update
packages=(
    # Bootstrap-only: no Brewfile counterpart. `wget` fetches the gh keyring
    # below; build-essential stands in for the Xcode CLI tools the darwin
    # bootstrap installs, which is what makes cmake, boost and CUnit below any
    # use.
    curl file fontconfig wget python3 ca-certificates build-essential
{{ includeTemplate "linux-packages" . | trim | indent 4 }}
)
"${SUDO[@]}" apt-get install -y "${packages[@]}"

# Debian/Ubuntu ship bat as "batcat" and fd as "fdfind"; expose the usual names.
mkdir -p "$HOME/.local/bin"
[ -e /usr/bin/batcat ] && ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
[ -e /usr/bin/fdfind ] && ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"

# GitHub CLI from its official repository.
"${SUDO[@]}" mkdir -p -m 755 /etc/apt/keyrings
wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | "${SUDO[@]}" tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null
"${SUDO[@]}" chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | "${SUDO[@]}" tee /etc/apt/sources.list.d/github-cli.list > /dev/null
"${SUDO[@]}" apt-get update
"${SUDO[@]}" apt-get install -y gh
{{- end }}

# Starship prompt is not in the base repos; use its official installer.
if ! command -v starship > /dev/null 2>&1; then
    curl -fsSL https://starship.rs/install.sh | "${SUDO[@]}" sh -s -- --yes
fi
{{- else }}
# --- no-sudo: rootless mise toolchain ---------------------------------------
if ! command -v mise > /dev/null 2>&1 && [ ! -x "$HOME/.local/bin/mise" ]; then
    curl -fsSL https://mise.run | sh
fi
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"
mise install
{{- end }}
{{ end -}}
