{{- /*
The distro package names for this machine, one entry per line (an entry may hold
more than one name, e.g. "nodejs npm"). Shared by the 01 bootstrap script, which
installs them, and by tests/docker/entrypoint.sh, which asks the package manager
whether they all resolve before anything is installed.
*/ -}}
{{- $target := includeTemplate "linux-target" . -}}
{{- range $tool, $p := .packages }}
{{- if hasKey $p $target }}
{{ index $p $target }}
{{- end }}
{{- end }}
