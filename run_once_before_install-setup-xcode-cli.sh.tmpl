{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash

# Without TERM (ssh without a tty, a container) tput exits 2 and prints an
# error; the styling is cosmetic, so it falls back to plain text.
bold=$(tput bold 2>/dev/null || true)
normal=$(tput sgr0 2>/dev/null || true)

echo "${bold}===Setup Xcode===${normal}"

# The pipeline's status is grep's, since grep ends it: non-zero means either
# pkgutil found no such package or its output had no version line. Both mean the
# command-line tools have to be installed.
if xcode_version=$(pkgutil --pkg-info=com.apple.pkg.CLTools_Executables | grep version); then
    # $xcode_version is grep's whole matching line, i.e. "version: 15.3.0.0.1".
    echo "Found Xcode CLI ${xcode_version}"
    echo "Skipping install"
else
    echo "Installing the Xcode command-line tools."
    echo "A window opens and asks to confirm; this waits until it has finished."
    xcode-select --install

    # `xcode-select --install` opens a GUI installer and returns immediately, so
    # block until a developer directory is selected. This reports the directory
    # rather than the package, so it can succeed slightly before the install has
    # finished writing.
    #
    # The wait has a ceiling because the dialog can be cancelled, and an apply
    # over ssh opens it on the console where nobody may see it -- either way
    # the directory never appears and the bootstrap would sit here silently.
    xcode_limit=3600
    waited=0
    until xcode-select --print-path > /dev/null 2>&1; do
        if [ "${waited}" -ge "${xcode_limit}" ]; then
            echo "The command-line tools were still not installed after ${xcode_limit}s:" >&2
            echo "the dialog was cancelled, or it opened where nobody saw it (an" >&2
            echo "apply over ssh opens it on the console). Run:" >&2
            echo "    xcode-select --install" >&2
            echo "confirm the dialog, and re-run 'chezmoi apply' once it finishes." >&2
            echo "This exit stopped the apply before anything was recorded, so the" >&2
            echo "re-run starts from here." >&2
            exit 1
        fi
        sleep 5
        waited=$((waited + 5))
    done
fi

# oahd is Rosetta's translation daemon: it runs only on Apple Silicon with
# Rosetta installed. On an Intel Mac it never matches and --install-rosetta
# fails, so this script exits 1 and stops the bootstrap -- Apple Silicon is
# assumed here and by the /opt/homebrew paths in scripts 01, 03, 04 and 05.
if /usr/bin/pgrep oahd > /dev/null 2>&1; then
    echo "Rosetta 2 is already installed"
else
    echo "Rosetta 2 is missing - installing"
    echo
    # --agree-to-license accepts Apple's licence without a prompt, so an
    # unattended apply is not left waiting on one.
    /usr/sbin/softwareupdate --install-rosetta --agree-to-license
    echo
    if /usr/bin/pgrep oahd > /dev/null 2>&1; then
        echo "Rosetta 2 is now installed"
    else
        echo "Rosetta 2 installation failed"
        exit 1
    fi
fi
{{ end -}}
