#!/bin/sh
# Unlocks the age key every other encrypted file in this repo is encrypted to.
# `--passphrase` prompts, so this is the one interactive step of the bootstrap
# and it blocks until answered. The passphrase is not in this repository.
#
# The guard tests only that the file exists, so a truncated or wrong key is
# accepted silently and every encrypted file then fails to render instead. The
# fix is to delete ~/.config/chezmoi/key.txt and apply again.
#
# run_onchange_ rather than run_once_: editing this script re-runs it, and it
# then does nothing on a machine whose key is already in place.

# Without TERM (ssh without a tty, a container) tput exits 2 and prints an
# error; the styling is cosmetic, so it falls back to plain text.
bold=$(tput bold 2>/dev/null || true)
normal=$(tput sgr0 2>/dev/null || true)

echo "${bold}===Decrypt Chezmoi files===${normal}"

if [ ! -f "${HOME}/.config/chezmoi/key.txt" ]; then
    # umask 077 creates the directory 0700 and the key 0600 from the first
    # byte; a chmod after the write would leave a window in which the
    # inherited umask has the key readable by other local users.
    umask 077
    mkdir -p "${HOME}/.config/chezmoi"
    chezmoi age decrypt --output "${HOME}/.config/chezmoi/key.txt" --passphrase "{{ .chezmoi.sourceDir }}/key.txt.age"
fi
